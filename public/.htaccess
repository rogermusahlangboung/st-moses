<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Let Apache serve real files and directories normally.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # React Router SPA fallback: send client-side routes to Vite's index.html.
  RewriteRule ^ index.html [L]
</IfModule>
